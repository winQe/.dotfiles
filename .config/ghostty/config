# Ported 1:1 from .wezterm.lua

# Fixed window title (wezterm's format-window-title override)
title = Ghostty

# Font
font-family = JetBrainsMono Nerd Font
font-style = SemiBold
font-size = 14

# No tab bar, native title bar (wezterm: enable_tab_bar = false)
macos-titlebar-style = native

# Colors (built-in theme, matches nvim/tmux)
theme = Catppuccin Mocha

# Left Option acts as Alt (wezterm default)
macos-option-as-alt = left
